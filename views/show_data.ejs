<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All user data</title>
    <style>
      table,
      th,
      td {
        border: 1px solid black;
      }
    </style>
  </head>
  <body>
    <table>
      <tr>
        <td>ID</td>
        <td>Email</td>
        <td>Username</td>
        <td>Edit</td>
      </tr>
      <% for(user of user){ %>
        <tr>
          <td><%=user.id%></td>
          <td><%=user.email%></td>
          <td><%=user.username%></td>
          <td>
            <form method="get" action="/user/<%=user.id%>/edit">
              <button> Edit Username</button>
            </form>
          </td>
        </tr>
      <%}%>
    </table>
  </body>
</html>
